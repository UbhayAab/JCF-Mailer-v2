# JCF Mailer / Campaign Studio - example environment
#
# Copy to a real env file and fill in. NOTHING in this file is a real credential;
# every value here is a placeholder.
#
# In production this file's real counterpart lives at /etc/jcfmailer.env, owned by
# root, mode 0600, and is loaded by the `jcfmailer` systemd unit via EnvironmentFile.
# It is deliberately outside the repo and must never be committed.
#
# Locally:  set these in your shell, your IDE run configuration, or a .env loader.
# Anything with a default in src/main/resources/application.properties can be left
# unset; only the entries marked REQUIRED have no working default.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres password for the application role.
DB_PASSWORD=change-me

# Seed owner account. Only used on first boot, when the user table is empty.
# After the first login this value is ignored; change the password in the console.
ADMIN_EMAIL=mailer@example.org
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/jarurat_mailer
DB_USER=mailer_admin

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# Base URL used to build tracking, unsubscribe and preference-centre links.
# Must be the externally reachable origin, not localhost, or those links break.
APP_DOMAIN=https://mailer.example.org

# Set to false only when running locally over plain HTTP, otherwise the session
# cookie is marked Secure and the browser will refuse to send it back.
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Amazon SES (outbound send path)
# ---------------------------------------------------------------------------
# Credentials are NOT set here as properties. The AWS SDK default provider chain
# is used, so supply EITHER an EC2 instance role (production, preferred, no keys
# on disk) OR the two standard variables below (local development only).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

AWS_REGION=ap-south-1
SES_DOMAIN=example.org
SES_FROM_EMAIL=admin@example.org
SES_FROM_NAME=Example Foundation
SES_REPLY_TO=admin@example.org

# SES configuration set. Leave empty and SES v2 publishes no per-message events,
# which means the message log can never learn what the recipient server replied.
SES_CONFIGURATION_SET=

# Account send quota is 14/sec. Stay under it so a throttle is never hit.
SES_MAX_SEND_RATE=12
SES_MAX_CONCURRENCY=16

# ---------------------------------------------------------------------------
# OTP service
# ---------------------------------------------------------------------------
# Keyed-hash pepper for stored OTP codes. If unset the service falls back to a
# per-process key and every outstanding code dies on restart. Generate with:
#   openssl rand -base64 32
OTP_PEPPER=

# ---------------------------------------------------------------------------
# Journeys
# ---------------------------------------------------------------------------
# Salt for stable A/B branch assignment. Changing it reshuffles every enrolled
# subscriber, so set it once and leave it.
JOURNEY_ASSIGNMENTSALT=jcf-journey-v1

# ---------------------------------------------------------------------------
# Stalwart mail server (webmail + mailbox administration)
# ---------------------------------------------------------------------------
# Optional. Leave unset and the Inbox and Mailboxes screens render a
# "not configured" notice instead of failing.
#
# The webmail path authenticates as the mailbox owner; the admin path below is a
# different port AND a different credential, authenticating as the server admin.
# Both must stay loopback addresses: the certificate carries one SAN, DNS:localhost,
# and the client only relaxes trust for a loopback peer.
MAIL_JMAP_URL=https://127.0.0.1/jmap/
MAIL_DOMAIN=example.org

# OAuth device-code refresh token for the Stalwart admin API. Does not self-expire.
STALWART_REFRESH_TOKEN=
MAIL_ADMIN_JMAP_URL=https://127.0.0.1:8443/jmap/
MAIL_ADMIN_TOKEN_URL=https://127.0.0.1:8443/auth/token
MAIL_ADMIN_ACCOUNT_ID=
MAIL_ADMIN_DOMAIN_ID=

# DNS resolvers for the Domains health checks. Empty means the OS resolvers.
# Override only if the local resolver truncates large TXT answers: nothing in a
# DNS reply marks it as abridged, so a truncating resolver reports a perfectly
# healthy domain as publishing no SPF record at all.
MAIL_DNS_SERVERS=

# ---------------------------------------------------------------------------
# Message log
# ---------------------------------------------------------------------------
# The table is written once per recipient per send, so retention is the knob that
# keeps it from growing without limit.
MESSAGELOG_RETENTION_DAYS=60

# Where the receiving server's verbatim SMTP reply is read from. Stalwart writes
# one date-suffixed file per day. The app user needs read access (an ACL, not a
# group). Set STALWART_LOG_ENABLED=false on any box not running Stalwart.
STALWART_LOG_ENABLED=false
STALWART_LOG_DIR=/var/log/stalwart
STALWART_LOG_PREFIX=stalwart

# ---------------------------------------------------------------------------
# Amazon SNS (bounce and complaint feedback)
# ---------------------------------------------------------------------------
# Comma-separated allowlist of topic ARNs accepted by the SNS webhook. Empty
# means every topic is rejected, which is the safe default.
JARURAT_SNS_ALLOWEDTOPICARNS=
